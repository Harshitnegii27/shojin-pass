# Copy to .env.local and fill in real values. Never commit .env.local.
# Names only here; see docs/spec.md section 7 for what each one is and where to find it.
# An empty value (NAME=) counts as not set.

# Supabase (Project Settings -> API Keys / Data API). Public: sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (public). Its secret key goes in the Supabase dashboard, not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secrets (server only)
SUPABASE_SERVICE_ROLE_KEY=
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=
CRON_SECRET=
HEALTH_SECRET=

# Supabase calls give up after this; scans still return their verdict
SUPABASE_TIMEOUT_MS=1500

# LLM: Google Gemini API (key from Google AI Studio). Writes only the "why" sentence (spec 11).
# Without a key, or if it fails, the template "why" is shown; scans never depend on it.
LLM_API_KEY=
LLM_MODEL=
LLM_ENABLED=true
LLM_TIMEOUT_MS=2000

# OCR (tune on the tuning set only)
OCR_TIMEOUT_MS=4000
OCR_MIN_PAGE_CONFIDENCE=0.80
OCR_MIN_CHAR_CONFIDENCE=0.70

# Limits and retention
SCAN_RATE_LIMIT_PER_MIN=20
SCAN_RATE_LIMIT_PER_DAY=300
IP_RATE_LIMIT_PER_MIN=60
SCAN_RETENTION_DAYS=90

# LOCAL DEVELOPMENT ONLY. Trusts rulebook entries that have fewer than two reviewers.
# Defaults to false when unset. Never set this to true in Vercel or any deployed environment:
# without it every label is amber (intended until the rulebook is reviewed).
RULEBOOK_ALLOW_UNREVIEWED=true
