# Copy to .env.local and fill in real values. Never commit .env.local.
# Names only here; see docs/spec.md section 7 for what each one is and where to find it.
# An empty value (NAME=) counts as not set.

# Supabase (Project Settings -> API Keys / Data API). Public: sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (public). Its secret key goes in the Supabase dashboard, not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secrets (server only)
SUPABASE_SERVICE_ROLE_KEY=
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=
CRON_SECRET=
HEALTH_SECRET=

# Supabase calls give up after this; scans still return their verdict
SUPABASE_TIMEOUT_MS=1500

# LLM: Google Gemini API (key from Google AI Studio; new keys start "AQ.", any non-empty value is
# accepted). Writes only the "why" explanation (spec 11). Without a key, or if it fails, the
# template "why" is shown; scans never depend on it.
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Lowest level the model accepts; "none" leaves the setting out of the request.
LLM_THINKING_LEVEL=minimal
LLM_ENABLED=true
LLM_TIMEOUT_MS=5000
# Explanations generated per user (answers from the cache don't count)
LLM_USER_PER_MIN=5
LLM_USER_PER_DAY=50

# OCR (tune on the tuning set only)
OCR_TIMEOUT_MS=4000
OCR_MIN_PAGE_CONFIDENCE=0.80
OCR_MIN_CHAR_CONFIDENCE=0.70

# Limits and retention. Per user is the main limit; per IP is ~3x higher (one venue Wi-Fi = one IP)
SCAN_RATE_LIMIT_PER_MIN=20
SCAN_RATE_LIMIT_PER_DAY=300
EXPLAIN_RATE_LIMIT_PER_MIN=30
FEEDBACK_RATE_LIMIT_PER_MIN=20
IP_RATE_LIMIT_PER_MIN=180
INSIGHTS_IP_RATE_LIMIT_PER_MIN=90
# Azure free tier allows 20 calls a minute for everyone together (polls count); over this -> "busy"
OCR_CALLS_PER_MIN=18
OCR_CALLS_PER_SCAN=2
RATE_LIMIT_TIMEOUT_MS=500
SCAN_RETENTION_DAYS=90

# LOCAL DEVELOPMENT ONLY. Trusts rulebook entries that have fewer than two reviewers.
# Defaults to false when unset. Never set this to true in Vercel or any deployed environment:
# without it every label is amber (intended until the rulebook is reviewed).
RULEBOOK_ALLOW_UNREVIEWED=true
